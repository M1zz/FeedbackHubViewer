#!/bin/bash
# 통계 스펙이 앱과 어긋난 채로 커밋되는 것을 막는다.
#
#   ① sync-stats-specs.sh --check — 뷰어의 사본이 앱 리포의 원본과 같은가
#   ② check-spec-drift.sh         — 스펙이 가리키는 지표를 앱이 아직 **보내는가**
#
# ②가 따로 있는 까닭: 두 파일이 **똑같이 틀릴 수 있다.** 두번알림이 알림 한도를
# 없애며 `trial.prealerts` 를 안 보내게 됐는데 스펙은 그 키로 "막힌 사람" 을 셌고,
# 없는 키는 0 으로 읽히니 그 칸은 몇 달 동안 늘 0 이었다. 0 은 "없다"처럼 보여서
# 화면도 사람도 아무 불평을 안 했다. ①만으로는 그 경우를 절대 못 잡는다.
#
# 긴급 우회: git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

source "$ROOT/scripts/spec-sources.sh"

# 앱 리포가 옆에 없는 기기에서는 대조할 상대가 없다. **막지 않고 지나간다** —
# 여기서 막으면 앱 리포를 안 받은 사람은 이 리포에 아무것도 커밋하지 못한다.
# 검사를 못 돌린 것과 검사가 통과한 것은 다르므로, 조용히 넘기지는 않는다.
for entry in "${SPECS[@]}"; do
  IFS='|' read -r repo rel _ <<< "$entry"
  if [[ ! -f "$repo/$rel" ]]; then
    echo "⚠️  스펙 검사를 건너뜁니다 — 앱 리포가 옆에 없습니다."
    echo "    없는 곳: $repo/$rel"
    exit 0
  fi
done

"$ROOT/scripts/sync-stats-specs.sh" --check || {
  echo ""
  echo "❌ 커밋 차단: 뷰어의 스펙 사본이 앱 리포의 원본과 다릅니다."
  echo "   ./scripts/sync-stats-specs.sh 로 가져온 뒤 다시 커밋하세요."
  echo "   (긴급 우회: git commit --no-verify)"
  exit 1
}

"$ROOT/scripts/check-spec-drift.sh" || {
  echo ""
  echo "❌ 커밋 차단: 스펙이 앱에 없는 지표·이벤트를 가리킵니다."
  echo "   그대로 두면 그 카드는 화면에서 **조용히 0** 이 됩니다."
  echo "   (긴급 우회: git commit --no-verify)"
  exit 1
}
